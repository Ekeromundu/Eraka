<?xml version="1.0" encoding="utf-8"?>
<!-- Eraka tile: white, rounded, soft mustard edge; mustard ripple when tapped.
     (Was OTTAA's orange ripple. Used around group / word tiles in the galleries.) -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/eraka_mustard_light">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white"/>
            <stroke android:width="1.5dp" android:color="@color/eraka_field_stroke"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
</ripple>
