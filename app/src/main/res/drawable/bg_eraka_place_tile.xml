<?xml version="1.0" encoding="utf-8"?>
<!-- Place tile: white; mustard when selected (setSelected) or pressed -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/eraka_mustard_light"/>
            <stroke android:width="2.5dp" android:color="@color/eraka_mustard"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/eraka_mustard_soft"/>
            <stroke android:width="2dp" android:color="@color/eraka_mustard"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white"/>
            <stroke android:width="1.5dp" android:color="@color/eraka_field_stroke"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
</selector>
