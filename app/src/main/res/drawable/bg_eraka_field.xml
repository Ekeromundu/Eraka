<?xml version="1.0" encoding="utf-8"?>
<!-- Pill input: soft cream fill, mustard hairline; green border while a child view has focus -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/eraka_field_bg"/>
            <stroke android:width="2dp" android:color="@color/eraka_green"/>
            <corners android:radius="22dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/eraka_field_bg"/>
            <stroke android:width="1.5dp" android:color="@color/eraka_field_stroke"/>
            <corners android:radius="22dp"/>
        </shape>
    </item>
</selector>
