<?xml version="1.0" encoding="utf-8"?>
<!-- Chunky "3D" mustard pill: darker lip underneath that flattens when pressed -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/eraka_mustard_dark"/>
                    <corners android:radius="20dp"/>
                </shape>
            </item>
            <item android:top="4dp" android:bottom="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/eraka_mustard"/>
                    <corners android:radius="20dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/eraka_mustard_dark"/>
                    <corners android:radius="20dp"/>
                </shape>
            </item>
            <item android:bottom="5dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/eraka_mustard"/>
                    <corners android:radius="20dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
