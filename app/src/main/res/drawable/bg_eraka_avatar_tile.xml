<?xml version="1.0" encoding="utf-8"?>
<!-- Soft tile behind each avatar in the grid; turns mustard while pressed -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/eraka_mustard_light"/>
            <stroke android:width="2dp" android:color="@color/eraka_mustard"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/eraka_field_bg"/>
            <stroke android:width="1.5dp" android:color="@color/eraka_field_stroke"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
</selector>
