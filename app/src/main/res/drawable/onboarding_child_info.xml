<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/WhiteSmoke">

    <!-- HEADER -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraint_brand_top"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_gradient_onboarding_top"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/cardViewOnboarding"
        app:layout_constraintHeight_min="150dp"
        app:layout_constraintVertical_weight="2.2">

        <ImageView
            android:id="@+id/brandBanner2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="fitXY"
            android:src="@drawable/ic_ola_naranja_rot"
            android:alpha="0.18"
            android:tint="@color/White"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <!-- Big translucent circle; the card slides over it -->
        <View
            android:id="@+id/headerCircle"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:background="@drawable/bg_header_circle"
            android:layout_marginEnd="-70dp"
            android:layout_marginBottom="-110dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <!-- NEW: small playful confetti dots so the header doesn't read as flat/corporate -->
        <View
            android:id="@+id/dotCoral"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="90dp"
            android:layout_marginTop="18dp"
            android:alpha="0.55"
            android:background="@drawable/bg_dot_coral"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <View
            android:id="@+id/dotYellow"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginStart="140dp"
            android:layout_marginTop="46dp"
            android:alpha="0.7"
            android:background="@drawable/bg_dot_yellow"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <View
            android:id="@+id/dotSky"
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:layout_marginEnd="120dp"
            android:layout_marginTop="10dp"
            android:alpha="0.6"
            android:background="@drawable/bg_dot_sky"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <FrameLayout
            android:id="@+id/mascotBadge"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_mascot_badge"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/mascotOnboarding"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_mascot_cloud"
                android:contentDescription="@string/mascot_desc"
                android:scaleType="fitCenter"/>
        </FrameLayout>

        <!-- Step indicator row -->
        <LinearLayout
            android:id="@+id/stepIndicatorRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/medium_margin"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <View
                android:id="@+id/stepDot1"
                android:layout_width="20dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_step_dot_active"/>

            <View
                android:id="@+id/stepDot2"
                android:layout_width="20dp"
                android:layout_height="6dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_step_dot_active"/>

            <View
                android:id="@+id/stepDot3"
                android:layout_width="20dp"
                android:layout_height="6dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_step_dot_inactive"/>

            <View
                android:id="@+id/stepDot4"
                android:layout_width="20dp"
                android:layout_height="6dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_step_dot_inactive"/>

            <TextView
                android:id="@+id/textStepIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#E8FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <TextView
            android:id="@+id/textOnboardingBig"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/medium_margin"
            android:layout_marginEnd="@dimen/small_margin"
            android:layout_marginTop="@dimen/small_margin"
            android:textColor="@color/White"
            android:textSize="17sp"
            android:textStyle="bold"
            android:text="@string/lets_get_to_know_this_child"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/mascotBadge"
            app:layout_constraintTop_toBottomOf="@id/stepIndicatorRow"
            app:layout_constraintBottom_toTopOf="@id/textOnboardingSmall"
            app:layout_constraintVertical_chainStyle="packed"/>

        <TextView
            android:id="@+id/textOnboardingSmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/medium_margin"
            android:layout_marginEnd="@dimen/medium_margin"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="36dp"
            android:textColor="#E8FFFFFF"
            android:textSize="13sp"
            android:text="@string/this_helps_us_personalize_communication"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textOnboardingBig"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- CARD -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardViewOnboarding"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardCornerRadius="36dp"
        app:cardPreventCornerOverlap="true"
        app:cardBackgroundColor="@color/White"
        app:cardUseCompatPadding="true"
        android:elevation="16dp"
        android:layout_marginStart="@dimen/medium_margin"
        android:layout_marginEnd="@dimen/medium_margin"
        android:layout_marginTop="-24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/constraint_brand_top"
        app:layout_constraintBottom_toTopOf="@id/constraintButtonsOnboarding"
        app:layout_constraintVertical_weight="7.8">

        <!--
          NEW: this wrapper clips its own corners to match the CardView's
          36dp radius. Without this, the ScrollView's content (and the
          white fade view below) draws right up to the rectangular bounds
          of the wrapper, which is what made the bottom edge look "square"
          instead of curvy once you scrolled — the CardView itself was
          always rounded, only child content beneath it wasn't clipped to
          that same curve.
        -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_card_rounded_mask"
            android:clipToOutline="true">

            <ScrollView
                android:id="@+id/onboardingScrollView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:scrollbars="none"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/medium_margin"
                    android:paddingBottom="48dp">

                    <!-- Reassurance microcopy (replaces the old intro text) -->
                    <TextView
                        android:id="@+id/textOnboardingReassurance"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textAlignment="center"
                        android:gravity="center"
                        android:textColor="#9E9E9E"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/no_wrong_answers_reassurance"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>

                    <TextView
                        android:id="@+id/textViewName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/medium_margin"
                        android:textColor="@color/erakaPrimary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:text="@string/text_name"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/textOnboardingReassurance"/>

                    <EditText
                        android:id="@+id/editTextName"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_field"
                        android:hint="@string/childs_name"
                        android:textSize="15sp"
                        android:inputType="text"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/textViewName"/>

                    <TextView
                        android:id="@+id/textViewBirthday"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/medium_margin"
                        android:textColor="@color/erakaPrimary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:text="@string/fecha_de_nacimiento"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/editTextName"/>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/constraintBirthDate"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_field"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/textViewBirthday">

                        <EditText
                            android:id="@+id/editTextBirthday"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:background="@android:color/transparent"
                            android:hint="DD/MM/YYYY"
                            android:textSize="15sp"
                            android:inputType="datetime"
                            android:maxLength="10"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/buttonCalendarDialog"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageButton
                            android:id="@+id/buttonCalendarDialog"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_event_black_24dp"
                            android:tint="@color/erakaPrimary"
                            android:background="@android:color/transparent"
                            android:onClick="onClick"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <TextView
                        android:id="@+id/textViewCommLevel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/medium_margin"
                        android:textColor="@color/erakaPrimary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:text="@string/communication_level"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/constraintBirthDate"/>

                    <!--
                      NOTE on the Spinner specifically: the framework Spinner
                      draws its own dropdown-arrow background layer UNDER
                      whatever you set via android:background on many OEM
                      skins, which is a common reason a Spinner's corners
                      look "undefined" compared to a plain EditText even
                      when they share the same drawable. If this still looks
                      inconsistent on device after swapping in the new
                      bg_input_field.xml, replace the Spinner with a
                      non-editable EditText + a bottom-sheet/dialog picker,
                      or an AutoCompleteTextView — both respect a custom
                      rounded background reliably, and let you show bigger,
                      easier-to-tap options for a kids/accessibility app.
                    -->
                    <Spinner
                        android:id="@+id/selectorCommLevel"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_field"
                        android:entries="@array/comm_level_options"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/textViewCommLevel"/>

                    <TextView
                        android:id="@+id/textViewInterests"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/medium_margin"
                        android:textColor="@color/erakaPrimary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:text="@string/what_does_your_child_enjoy"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/selectorCommLevel" />

                    <!--
                      CHIP FIX: each chip now has its own pastel/vivid color
                      pair (res/color/chip_bg_*.xml) instead of a plain white
                      background with only a stroke, and every chip has:
                        - android:checkable="true"      (was relying on the
                          style default, which some OEM/theme overrides can
                          silently turn off)
                        - app:checkedIconVisible="true"  (was missing, so no
                          checkmark ever appeared)
                        - app:checkedIconTint="@color/White" on every chip
                          (previously only set on chipFood, so the others had
                          an invisible/wrong-colored tick)
                        - app:chipStrokeWidth="0dp"      (the colored fill
                          now carries the "selected" feedback, so the outline
                          is no longer needed — also more colorful/fun)
                    -->
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupInterests"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/small_margin"
                        app:singleSelection="false"
                        app:chipSpacingHorizontal="8dp"
                        app:chipSpacingVertical="8dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/textViewInterests">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipFood"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Widget.MaterialComponents.Chip.Filter"
                            android:checkable="true"
                            app:chipBackgroundColor="@color/chip_bg_food"
                            app:chipStrokeWidth="0dp"
                            app:checkedIconVisible="true"
                            app:checkedIconTint="@color/White"
                            app:rippleColor="@color/White"
                            android:textColor="@color/chip_text_selector"
                            android:text="@string/interest_food"/>

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipAnimals"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Widget.MaterialComponents.Chip.Filter"
                            android:checkable="true"
                            app:chipBackgroundColor="@color/chip_bg_animals"
                            app:chipStrokeWidth="0dp"
                            app:checkedIconVisible="true"
                            app:checkedIconTint="@color/White"
                            app:rippleColor="@color/White"
                            android:textColor="@color/chip_text_selector"
                            android:text="@string/interest_animals"/>

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipFamily"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Widget.MaterialComponents.Chip.Filter"
                            android:checkable="true"
                            app:chipBackgroundColor="@color/chip_bg_family"
                            app:chipStrokeWidth="0dp"
                            app:checkedIconVisible="true"
                            app:checkedIconTint="@color/White"
                            app:rippleColor="@color/White"
                            android:textColor="@color/chip_text_selector"
                            android:text="@string/interest_family"/>

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipMusic"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Widget.MaterialComponents.Chip.Filter"
                            android:checkable="true"
                            app:chipBackgroundColor="@color/chip_bg_music"
                            app:chipStrokeWidth="0dp"
                            app:checkedIconVisible="true"
                            app:checkedIconTint="@color/White"
                            app:rippleColor="@color/White"
                            android:textColor="@color/chip_text_selector"
                            android:text="@string/interest_music"/>

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipOutdoors"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Widget.MaterialComponents.Chip.Filter"
                            android:checkable="true"
                            app:chipBackgroundColor="@color/chip_bg_outdoors"
                            app:chipStrokeWidth="0dp"
                            app:checkedIconVisible="true"
                            app:checkedIconTint="@color/White"
                            app:rippleColor="@color/White"
                            android:textColor="@color/chip_text_selector"
                            android:text="@string/interest_outdoors"/>

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipSchool"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Widget.MaterialComponents.Chip.Filter"
                            android:checkable="true"
                            app:chipBackgroundColor="@color/chip_bg_school"
                            app:chipStrokeWidth="0dp"
                            app:checkedIconVisible="true"
                            app:checkedIconTint="@color/White"
                            app:rippleColor="@color/White"
                            android:textColor="@color/chip_text_selector"
                            android:text="@string/interest_school"/>

                    </com.google.android.material.chip.ChipGroup>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </ScrollView>

            <!-- Fade so content trails off before the card's edge -->
            <View
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_fade_bottom_white"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <!-- Chevron hint that there's more to scroll -->
            <ImageView
                android:id="@+id/scrollDownHint"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginBottom="6dp"
                android:alpha="0.85"
                android:src="@drawable/ic_chevron_down"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <!-- BUTTONS -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintButtonsOnboarding"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="@dimen/activity_vertical_margin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardViewOnboarding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_weight="1">

        <Button
            android:id="@+id/backButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginEnd="@dimen/small_margin"
            android:text="@string/back"
            android:textColor="@color/erakaPrimary"
            android:textStyle="bold"
            android:background="@drawable/bg_button_outline_primary"
            android:elevation="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/nextButton"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <Button
            android:id="@+id/nextButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/medium_margin"
            android:text="@string/next"
            android:textColor="@color/White"
            android:textStyle="bold"
            android:background="@drawable/bg_button_pill_primary"
            android:elevation="4dp"
            app:layout_constraintStart_toEndOf="@id/backButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
