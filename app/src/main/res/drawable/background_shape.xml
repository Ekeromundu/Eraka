<?xml version="1.0" encoding="utf-8"?>
<!-- Overrides the OTTAA PictogramsLibrary's background_shape (same name = app version wins).
     Background of every PictoView / GroupView: clean white rounded tile, mustard ripple. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/eraka_mustard_light">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
</ripple>
