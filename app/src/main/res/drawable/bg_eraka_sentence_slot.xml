<?xml version="1.0" encoding="utf-8"?>
<!-- Slot in the sentence strip: white rounded tile, mustard hairline, mustard ripple -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/eraka_mustard_light">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white"/>
            <stroke android:width="1.5dp" android:color="@color/eraka_field_stroke"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
</ripple>
