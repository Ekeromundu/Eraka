<?xml version="1.0" encoding="utf-8"?>
<!-- "Where should the picture come from?" dialog (Edit_Picto_Visual.SelectorFuente).
     Eraka style, fits portrait phones. ids: titulo, Camara/textAudio, Galeria/textImagen, Arasaac/textArasaac -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/eraka_cream_bg"
    app:cardCornerRadius="28dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/eraka_mustard_light"
            android:gravity="center"
            android:padding="16dp"
            android:text="@string/pref_elija"
            android:textColor="@color/eraka_text_dark"
            android:textSize="17sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:id="@+id/botones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/Camara"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:background="@drawable/bg_eraka_place_tile"
                    android:contentDescription="@string/pref_select_camara"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_hacer_fotos"
                    android:tag="skin:ic_hacer_fotos"/>

                <TextView
                    android:id="@+id/textAudio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/pref_select_camara"
                    android:textColor="@color/eraka_text_dark"
                    android:textSize="13sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/Galeria"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:background="@drawable/bg_eraka_place_tile"
                    android:contentDescription="@string/pref_select_galeria"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_album_fotografico"
                    android:tag="skin:ic_album_fotografico"/>

                <TextView
                    android:id="@+id/textImagen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/pref_select_galeria"
                    android:textColor="@color/eraka_text_dark"
                    android:textSize="13sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/Arasaac"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:background="@drawable/bg_eraka_place_tile"
                    android:contentDescription="@string/pref_select_pictos"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_pictogramas"/>

                <TextView
                    android:id="@+id/textArasaac"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/pref_select_pictos"
                    android:textColor="@color/eraka_text_dark"
                    android:textSize="13sp"
                    android:textStyle="bold"/>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
