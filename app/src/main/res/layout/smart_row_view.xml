<?xml version="1.0" encoding="utf-8"?>
<!-- Eraka 27 Oct 2026: the suggestion row with round arrows at its ends that show there are
     more suggestions to the side (hidden when the row is at that end; SmartRowView) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="88dp">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/smartRowRecycler"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:scrollbars="none" />

    <ImageView
        android:id="@+id/smartRowMoreLeft"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="2dp"
        android:background="@drawable/bg_eraka_round_button"
        android:contentDescription="@string/smart_row_more_left"
        android:elevation="4dp"
        android:padding="5dp"
        android:rotation="180"
        android:src="@drawable/ic_keyboard_arrow_right_black_24dp"
        android:tint="@color/eraka_green_dark"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/smartRowMoreRight"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="2dp"
        android:background="@drawable/bg_eraka_round_button"
        android:contentDescription="@string/smart_row_more_right"
        android:elevation="4dp"
        android:padding="5dp"
        android:src="@drawable/ic_keyboard_arrow_right_black_24dp"
        android:tint="@color/eraka_green_dark"
        android:visibility="gone" />
</FrameLayout>
