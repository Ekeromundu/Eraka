<?xml version="1.0" encoding="utf-8"?>
<!-- Friendly full-screen loader shown between onboarding screens (see utils/ErakaLoader.java).
     Layers: blurred snapshot (older Android only) -> soft cream wash -> card. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Pre-Android 12 fallback: a blurred snapshot of the screen behind -->
    <ImageView
        android:id="@+id/loaderBlurFallback"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:visibility="gone"/>

    <!-- Soft cream wash that fades the page out -->
    <View
        android:id="@+id/loaderScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/eraka_loader_scrim"/>

    <LinearLayout
        android:id="@+id/loaderCard"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_eraka_loader_card"
        android:elevation="8dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="22dp">

        <ImageView
            android:id="@+id/loaderMascot"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="@string/mascot_desc"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_mascot_cloud"/>

        <ProgressBar
            android:id="@+id/loaderProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="16dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/eraka_mustard"
            android:indeterminateTintMode="src_in"
            android:progressBackgroundTint="@color/eraka_mustard_light"/>

        <TextView
            android:id="@+id/loaderMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="@string/loader_please_wait"
            android:textColor="@color/eraka_text_dark"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/loaderSubMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/loader_this_can_take_a_moment"
            android:textColor="@color/eraka_text_muted"
            android:textSize="13sp"/>
    </LinearLayout>
</FrameLayout>
