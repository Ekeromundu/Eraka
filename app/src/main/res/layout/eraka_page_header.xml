<?xml version="1.0" encoding="utf-8"?>
<!-- Shared page header: round back button + title. Include with <include layout="@layout/eraka_page_header"/> -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/erakaPageHeader"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <ImageButton
        android:id="@+id/erakaBackButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_eraka_round_button"
        android:contentDescription="@string/back"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_eraka_back"
        android:tint="@color/eraka_green_dark"/>

    <TextView
        android:id="@+id/erakaPageTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/eraka_text_dark"
        android:textSize="22sp"
        android:textStyle="bold"/>
</LinearLayout>
