<?xml version="1.0" encoding="utf-8"?>
<!-- Eraka portrait version of OTTAA's "Suggestions" tip dialog (same view ids). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_eraka_dialog"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/titulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/sugerencias"
        android:textColor="@color/eraka_text_dark"
        android:textSize="22sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/constraintImagenes"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/image_abrazar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/abrazar" />

        <ImageView
            android:id="@+id/flecha_cambio"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_keyboard_arrow_right_black_24dp" />

        <ImageView
            android:id="@+id/image_abrazar_opaco"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:alpha="0.5"
            android:scaleType="fitCenter"
            android:src="@drawable/abrazar" />
    </LinearLayout>

    <TextView
        android:id="@+id/text_descripcion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/eraka_text_dark"
        android:textSize="15sp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_dialog"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_eraka_button_mustard"
        android:text="OK"
        android:textColor="@color/eraka_text_on_mustard"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
