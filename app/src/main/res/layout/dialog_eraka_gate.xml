<?xml version="1.0" encoding="utf-8"?>
<!-- Caregiver lock: a simple sum a young child can't easily answer. See utils/CaregiverGate.java -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_eraka_dialog"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_eraka_logo_badge">
        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_lock_outline_black_24dp"
            android:tint="@color/eraka_green_dark"/>
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/gate_title"
        android:textColor="@color/eraka_text_dark"
        android:textSize="20sp"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="@string/gate_hint"
        android:textColor="@color/eraka_text_muted"
        android:textSize="13sp"/>

    <TextView
        android:id="@+id/gateQuestion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:textColor="@color/eraka_green_dark"
        android:textSize="24sp"
        android:textStyle="bold"/>

    <LinearLayout
        android:id="@+id/gateAnswers"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"/>

    <TextView
        android:id="@+id/gateError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/gate_wrong"
        android:textColor="#C0392B"
        android:textSize="13sp"
        android:visibility="invisible"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/gateCancel"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_eraka_button_back"
        android:minWidth="120dp"
        android:minHeight="0dp"
        android:stateListAnimator="@null"
        android:text="@string/gate_cancel"
        android:textAllCaps="false"
        android:textColor="@color/eraka_green_dark"
        android:textStyle="bold"/>
</LinearLayout>
