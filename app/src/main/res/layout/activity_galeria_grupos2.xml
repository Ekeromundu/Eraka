<?xml version="1.0" encoding="utf-8"?>
<!--
  Group gallery ("All" on the main board) and words-in-a-group gallery.
  Shared by GaleriaGrupos2 and GaleriaPictos3 - Eraka style.
  Same ids/types as before: toolbar, btnBarrido, contentContainer, textoCargandoGrupos,
  textoCargandoPictos, progressBar, recyclerView, viewPager_groups, bottomActionBar,
  back_button, up_button, down_button, edit_button, btnTalk, floatting_button.
  Tiles themselves: drawable/picto_shape + drawable/background_shape + layout/group.xml, pictogram.xml
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eraka_cream_bg"
    tools:mContext="na.eraka.GroupGalleryActivity">

    <!-- Green rounded header (toolbar icons are white, so they stay readable) -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_eraka_toolbar_green"
        android:elevation="4dp"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:titleTextColor="@color/White"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"/>

    <!-- Invisible full-width tap target used by screen-scanning (barrido). -->
    <Button
        android:id="@+id/btnBarrido"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomActionBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar"/>

    <!-- Content: cream panel holding the grid (recyclerView) or the swipe carousel (viewPager_groups) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_eraka_panel"
        android:padding="8dp"
        app:layout_constraintBottom_toTopOf="@id/bottomActionBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <TextView
            android:id="@+id/textoCargandoGrupos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/estamos_cargando_sus_grupos"
            android:textColor="@color/eraka_text_dark"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <TextView
            android:id="@+id/textoCargandoPictos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/estamos_cargando_sus_pictos"
            android:textColor="@color/eraka_text_muted"
            android:textSize="14sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textoCargandoGrupos"/>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:indeterminateTint="@color/eraka_mustard"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:longClickable="true"
            android:scrollbars="none"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager_groups"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Bottom bar: green waves, round white buttons, Speak in the middle -->
    <LinearLayout
        android:id="@+id/bottomActionBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_eraka_bottom_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="24dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/back_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_eraka_round_button"
                android:contentDescription="Close"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_eraka_close"
                android:tint="@color/eraka_green_dark"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Close"
                android:textColor="@color/White"
                android:textSize="11sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/up_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_eraka_round_button"
                android:contentDescription="Previous"
                android:padding="10dp"
                android:rotation="180"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_skip_next_black_24dp"
                android:tint="@color/eraka_green_dark"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Previous"
                android:textColor="@color/White"
                android:textSize="11sp"
                android:textStyle="bold"/>

        </LinearLayout>

            <!-- Eraka 28 Oct 2026: Speak is now one of the four equal slots (Close, Previous, Speak,
                 Next), so the buttons are evenly spaced across the bar -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/btnTalk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="Speak"
                    android:elevation="8dp"
                    android:src="@drawable/icono_ottaa"
                    app:backgroundTint="@color/eraka_mustard"
                    app:fabCustomSize="64dp"
                    app:maxImageSize="38dp"
                    app:tint="@color/eraka_text_on_mustard"/>

                <!-- a label like the other buttons, so all four button centres line up -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Speak"
                    android:textColor="@color/White"
                    android:textSize="11sp"
                    android:textStyle="bold"/>
            </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/down_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_eraka_round_button"
                android:contentDescription="Next"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_skip_next_black_24dp"
                android:tint="@color/eraka_green_dark"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Next"
                android:textColor="@color/White"
                android:textSize="11sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/edit_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_eraka_round_button"
                android:contentDescription="Edit or search"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_edit_white_24dp"
                android:tint="@color/eraka_green_dark"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Edit"
                android:textColor="@color/White"
                android:textSize="11sp"
                android:textStyle="bold"/>

        </LinearLayout>

    </LinearLayout>


    <!-- Screen-scanning touch indicator (used by BarridoPantalla) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/floatting_button"
        android:layout_width="@dimen/sizeFloattingButtonMed"
        android:layout_height="@dimen/sizeFloattingButtonMed"
        android:backgroundTint="@color/color_blue_transparent"
        android:src="@drawable/ic_touch_app_black_24dp"
        android:visibility="gone"
        app:backgroundTint="@color/Black"
        app:borderWidth="2dp"
        app:maxImageSize="@dimen/sizeFloattingButtonIconMed"
        app:layout_constraintBottom_toTopOf="@id/bottomActionBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
