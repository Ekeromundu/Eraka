<?xml version="1.0" encoding="utf-8"?>
<!-- "Where are we?" picker. Tiles are added in code by utils/ErakaPlaces.java -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_eraka_dialog"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/places_title"
        android:textColor="@color/eraka_text_dark"
        android:textSize="22sp"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="@string/places_subtitle"
        android:textColor="@color/eraka_text_muted"
        android:textSize="13sp"/>

    <!-- 22 Oct 2026: scrollable, so 10 places fit on small phones and tablets in landscape -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fadeScrollbars="false">

        <LinearLayout
            android:id="@+id/placesGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>
    </ScrollView>
</LinearLayout>
