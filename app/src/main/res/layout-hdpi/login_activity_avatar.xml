<?xml version="1.0" encoding="utf-8"?>
<!--
  Onboarding: choose an avatar. Same playful style as login_activity_2
  (cream background, mustard + leaf-green accents, grass strip).
  IDs used by LoginActivity2Avatar.java (keep them!):
    orangeBanner2 (mascot), imagen3personas (grass strip), imgAvatar,
    textLoginBig, textLoginSmall, backButton, nextButton,
    buttonSelectAvatarSource, constraintSourceButtons,
    buttonSourceGallery, buttonSourceCamera, avatar11..avatar35
  NOTE: every ImageView with android:onClick="onClick" that the activity
  does not handle by id is treated as an avatar tap - keep onClick only
  on the avatars and the buttons above.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eraka_cream_bg">

    <!-- Grass strip (slides up from the bottom on entry) -->
    <ImageView
        android:id="@+id/imagen3personas"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        app:layout_constraintDimensionRatio="360:80"
        app:layout_constraintHeight_max="110dp"
        android:src="@drawable/bg_eraka_grass"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/backButton"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_eraka_button_back"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:stateListAnimator="@null"
        android:text="@string/back"
        android:textAllCaps="false"
        android:textColor="@color/eraka_green_dark"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- HEADER -->
    <TextView
        android:id="@+id/textLoginBig"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="52dp"
        android:layout_marginEnd="32dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="@string/por_ltimo"
        android:textColor="@color/eraka_text_dark"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/textLoginSmall"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="40dp"
        android:gravity="center"
        android:text="@string/elige_un_personaje_que_nmejor_te_represente"
        android:textColor="@color/eraka_text_muted"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textLoginBig"/>

    <!-- CREAM PANEL -->
    <FrameLayout
        android:id="@+id/cardViewAvatar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="70dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_eraka_panel"
        app:layout_constraintBottom_toTopOf="@id/nextButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textLoginSmall">

        <ScrollView
            android:id="@+id/avatarScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingStart="14dp"
            android:paddingTop="36dp"
            android:paddingEnd="14dp"
            android:paddingBottom="16dp"
            android:scrollbars="none">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Selected avatar preview with mustard ring -->
                <FrameLayout
                    android:id="@+id/circularConstraint"
                    android:layout_width="124dp"
                    android:layout_height="124dp"
                    android:background="@drawable/bg_eraka_avatar_ring"
                    android:padding="12dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/imgAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/choose_your_avatar"
                        android:scaleType="fitCenter"
                        android:src="@drawable/circulo"/>
                </FrameLayout>

                <!-- Edit (pick photo) button on the ring -->
                <ImageButton
                    android:id="@+id/buttonSelectAvatarSource"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_eraka_circle_green"
                    android:contentDescription="@string/choose_your_avatar"
                    android:onClick="onClick"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_menu_gallery"
                    android:tint="@android:color/white"
                    app:layout_constraintBottom_toBottomOf="@id/circularConstraint"
                    app:layout_constraintEnd_toEndOf="@id/circularConstraint"/>

                <!-- Own photo: two clear buttons under the preview -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/constraintSourceButtons"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/circularConstraint">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/buttonSourceGallery"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_eraka_button_back"
                        android:drawableStart="@drawable/ic_menu_gallery"
                        android:drawablePadding="6dp"
                        android:drawableTint="@color/eraka_green_dark"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:onClick="onClick"
                        android:paddingStart="14dp"
                        android:paddingEnd="16dp"
                        android:stateListAnimator="@null"
                        android:text="@string/avatar_upload_photo"
                        android:textAllCaps="false"
                        android:textColor="@color/eraka_green_dark"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@id/buttonSourceCamera"
                        app:layout_constraintHorizontal_chainStyle="packed"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/buttonSourceCamera"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_eraka_button_back"
                        android:drawableStart="@drawable/ic_menu_camera"
                        android:drawablePadding="6dp"
                        android:drawableTint="@color/eraka_green_dark"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:onClick="onClick"
                        android:paddingStart="14dp"
                        android:paddingEnd="16dp"
                        android:stateListAnimator="@null"
                        android:text="@string/avatar_take_photo"
                        android:textAllCaps="false"
                        android:textColor="@color/eraka_green_dark"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/buttonSourceGallery"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:id="@+id/textViewChooseAvatar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="@string/avatar_or_pick_character"
                    android:textColor="@color/eraka_green_dark"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/constraintSourceButtons"/>


                <!-- Eraka 27 Oct 2026: skin colour of the avatars (and of the people in the pictures) -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupAvatarTone"
                    android:visibility="gone"
                    android:theme="@style/Theme.MaterialComponents.Light.NoActionBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:chipSpacingHorizontal="6dp"
                    app:singleSelection="true"
                    app:selectionRequired="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/textViewChooseAvatar">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipAvatarLight"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:textSize="13sp"
                        android:textColor="@color/chip_text_eraka"
                        app:chipBackgroundColor="@color/chip_bg_eraka"
                        app:chipStrokeWidth="0dp"
                        app:chipMinHeight="36dp"
                        android:text="@string/skin_light"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipAvatarMedium"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:textSize="13sp"
                        android:textColor="@color/chip_text_eraka"
                        app:chipBackgroundColor="@color/chip_bg_eraka"
                        app:chipStrokeWidth="0dp"
                        app:chipMinHeight="36dp"
                        android:text="@string/skin_medium"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipAvatarDark"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:textSize="13sp"
                        android:textColor="@color/chip_text_eraka"
                        app:chipBackgroundColor="@color/chip_bg_eraka"
                        app:chipStrokeWidth="0dp"
                        app:chipMinHeight="36dp"
                        android:text="@string/skin_dark"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipAvatarMixed"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:textSize="13sp"
                        android:textColor="@color/chip_text_eraka"
                        app:chipBackgroundColor="@color/chip_bg_eraka"
                        app:chipStrokeWidth="0dp"
                        app:chipMinHeight="36dp"
                        android:text="@string/skin_mixed"/>

                </com.google.android.material.chip.ChipGroup>

                <!-- 5 x 3 avatar grid -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/gridAvatar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/chipGroupAvatarTone">

                    <ImageButton
                        android:id="@+id/avatar11"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_eraka_avatar_tile"
                        android:contentDescription="@string/choose_your_avatar"
                        android:onClick="onClick"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_avatar11"
                        android:tag="avatar11"
                        app:layout_constraintDimensionRatio="1:1"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/avatar12"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toTopOf="@id/avatar21"/>
                    <ImageButton
                        android:id="@+id/avatar12"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_eraka_avatar_tile"
                        android:contentDescription="@string/choose_your_avatar"
                        android:onClick="onClick"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_avatar12"
                        android:tag="avatar12"
                        app:layout_constraintDimensionRatio="1:1"
                        app:layout_constraintStart_toEndOf="@id/avatar11"
                        app:layout_constraintEnd_toStartOf="@id/avatar13"
                        app:layout_constraintTop_toTopOf="@id/avatar11"
                        app:layout_constraintBottom_toBottomOf="@id/avatar11"/>
                    <ImageButton
                        android:id="@+id/avatar13"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_eraka_avatar_tile"
                        android:contentDescription="@string/choose_your_avatar"
                        android:onClick="onClick"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_avatar13"
                        android:tag="avatar13"
                        app:layout_constraintDimensionRatio="1:1"
                        app:layout_constraintStart_toEndOf="@id/avatar12"
                        app:layout_constraintEnd_toStartOf="@id/avatar14"
                        app:layout_constraintTop_toTopOf="@id/avatar11"
                        app:layout_constraintBottom_toBottomOf="@id/avatar11"/>
                    <ImageButton
                        android:id="@+id/avatar14"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_eraka_avatar_tile"
                        android:contentDescription="@string/choose_your_avatar"
                        android:onClick="onClick"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_avatar14"
                        android:tag="avatar14"
                        app:layout_constraintDimensionRatio="1:1"
                        app:layout_constraintStart_toEndOf="@id/avatar13"
                        app:layout_constraintEnd_toStartOf="@id/avatar15"
                        app:layout_constraintTop_toTopOf="@id/avatar11"
                        app:layout_constraintBottom_toBottomOf="@id/avatar11"/>
                    <ImageButton
                        android:id="@+id/avatar15"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_eraka_avatar_tile"
                        android:contentDescription="@string/choose_your_avatar"
                        android:onClick="onClick"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_avatar15"
                        android:tag="avatar15"
                        app:layout_constraintDimensionRatio="1:1"
                        app:layout_constraintStart_toEndOf="@id/avatar14"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/avatar11"
                        app:layout_constraintBottom_toBottomOf="@id/avatar11"/>
                    <ImageButton
                        android:id="@+id/avatar21"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_eraka_avatar_tile"
                        android:contentDescription="@string/choose_your_avatar"
                        android:onClick="onClick"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_avatar21"
                        android:tag="avatar21"
                        app:layout_constraintDimensionRatio="1:1"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/avatar22"
                        app:layout_constraintTop_toBottomOf="@id/avatar11"
                        app:layout_constraintBottom_toTopOf="@id/avatar31"/>
                    <ImageButton
                        android:id="@+id/avatar22"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_eraka_avatar_tile"
                        android:contentDescription="@string/choose_your_avatar"
                        android:onClick="onClick"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_avatar22"
                        android:tag="avatar22"
                        app:layout_constraintDimensionRatio="1:1"
                        app:layout_constraintStart_toEndOf="@id/avatar21"
                        app:layout_constraintEnd_toStartOf="@id/avatar23"
                        app:layout_constraintTop_toTopOf="@id/avatar21"
                        app:layout_constraintBottom_toBottomOf="@id/avatar21"/>
                    <ImageButton
                        android:id="@+id/avatar23"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_eraka_avatar_tile"
                        android:contentDescription="@string/choose_your_avatar"
                        android:onClick="onClick"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_avatar23"
                        android:tag="avatar23"
                        app:layout_constraintDimensionRatio="1:1"
                        app:layout_constraintStart_toEndOf="@id/avatar22"
                        app:layout_constraintEnd_toStartOf="@id/avatar24"
                        app:layout_constraintTop_toTopOf="@id/avatar21"
                        app:layout_constraintBottom_toBottomOf="@id/avatar21"/>
                    <ImageButton
                        android:id="@+id/avatar24"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_eraka_avatar_tile"
                        android:contentDescription="@string/choose_your_avatar"
                        android:onClick="onClick"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_avatar24"
                        android:tag="avatar24"
                        app:layout_constraintDimensionRatio="1:1"
                        app:layout_constraintStart_toEndOf="@id/avatar23"
                        app:layout_constraintEnd_toStartOf="@id/avatar25"
                        app:layout_constraintTop_toTopOf="@id/avatar21"
                        app:layout_constraintBottom_toBottomOf="@id/avatar21"/>
                    <ImageButton
                        android:id="@+id/avatar25"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_eraka_avatar_tile"
                        android:contentDescription="@string/choose_your_avatar"
                        android:onClick="onClick"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_avatar25"
                        android:tag="avatar25"
                        app:layout_constraintDimensionRatio="1:1"
                        app:layout_constraintStart_toEndOf="@id/avatar24"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/avatar21"
                        app:layout_constraintBottom_toBottomOf="@id/avatar21"/>
                    <ImageButton
                        android:id="@+id/avatar31"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_eraka_avatar_tile"
                        android:contentDescription="@string/choose_your_avatar"
                        android:onClick="onClick"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_avatar31"
                        android:tag="avatar31"
                        app:layout_constraintDimensionRatio="1:1"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/avatar32"
                        app:layout_constraintTop_toBottomOf="@id/avatar21"
                        app:layout_constraintBottom_toBottomOf="parent"/>
                    <ImageButton
                        android:id="@+id/avatar32"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_eraka_avatar_tile"
                        android:contentDescription="@string/choose_your_avatar"
                        android:onClick="onClick"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_avatar32"
                        android:tag="avatar32"
                        app:layout_constraintDimensionRatio="1:1"
                        app:layout_constraintStart_toEndOf="@id/avatar31"
                        app:layout_constraintEnd_toStartOf="@id/avatar33"
                        app:layout_constraintTop_toTopOf="@id/avatar31"
                        app:layout_constraintBottom_toBottomOf="@id/avatar31"/>
                    <ImageButton
                        android:id="@+id/avatar33"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_eraka_avatar_tile"
                        android:contentDescription="@string/choose_your_avatar"
                        android:onClick="onClick"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_avatar33"
                        android:tag="avatar33"
                        app:layout_constraintDimensionRatio="1:1"
                        app:layout_constraintStart_toEndOf="@id/avatar32"
                        app:layout_constraintEnd_toStartOf="@id/avatar34"
                        app:layout_constraintTop_toTopOf="@id/avatar31"
                        app:layout_constraintBottom_toBottomOf="@id/avatar31"/>
                    <ImageButton
                        android:id="@+id/avatar34"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_eraka_avatar_tile"
                        android:contentDescription="@string/choose_your_avatar"
                        android:onClick="onClick"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_avatar34"
                        android:tag="avatar34"
                        app:layout_constraintDimensionRatio="1:1"
                        app:layout_constraintStart_toEndOf="@id/avatar33"
                        app:layout_constraintEnd_toStartOf="@id/avatar35"
                        app:layout_constraintTop_toTopOf="@id/avatar31"
                        app:layout_constraintBottom_toBottomOf="@id/avatar31"/>
                    <ImageButton
                        android:id="@+id/avatar35"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_eraka_avatar_tile"
                        android:contentDescription="@string/choose_your_avatar"
                        android:onClick="onClick"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_avatar35"
                        android:tag="avatar35"
                        app:layout_constraintDimensionRatio="1:1"
                        app:layout_constraintStart_toEndOf="@id/avatar34"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/avatar31"
                        app:layout_constraintBottom_toBottomOf="@id/avatar31"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>
        <!-- Eraka 27 Oct 2026: shows that there is more below; hidden at the bottom (ErakaScrollHint) -->
        <LinearLayout
            android:id="@+id/scrollHint"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_eraka_scroll_hint"
            android:clickable="true"
            android:contentDescription="@string/scroll_more_below"
            android:elevation="6dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="10dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/scroll_more_below"
                android:textColor="@color/eraka_text_on_mustard"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="4dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_eraka_arrow_down"/>
        </LinearLayout>

    </FrameLayout>

    <!-- Mascot peeking over the panel's top-right corner (slides in from the left) -->
    <ImageView
        android:id="@+id/orangeBanner2"
        android:layout_width="210dp"
        android:layout_height="68dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="30dp"
        android:contentDescription="@string/login_children_desc"
        android:elevation="4dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_eraka_children"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textLoginSmall"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/nextButton"
        android:layout_width="0dp"
